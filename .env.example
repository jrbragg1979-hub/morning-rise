# OpenAI (for TTS)
OPENAI_API_KEY=sk-...

# Weather (free tier: openweathermap.org)
WEATHER_API_KEY=your_key
WEATHER_LAT=32.7767
WEATHER_LON=-96.7970

# Google Calendar (OAuth credentials JSON path)
GOOGLE_CREDENTIALS_PATH=credentials.json

# Recipient
RECIPIENT_NAME=Mom
ALARM_TIME=06:50

# YouTube Music playlist URL (opens in app on iOS)
YOUTUBE_MUSIC_PLAYLIST_URL=https://music.youtube.com/playlist?list=YOUR_PLAYLIST_ID

# Server
PORT=3003
SECRET_KEY=change-me

# Local timezone for game-day lookups (IANA name)
LOCAL_TIMEZONE=America/Los_Angeles
